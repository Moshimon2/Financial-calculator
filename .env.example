# fincalc settings. Copy to .env (OMV: paste into the compose file's
# "Environment" field). Never commit the real .env.

# Host folder for the SQLite database. On OMV use a shared folder on the HDD,
# e.g. /srv/dev-disk-by-uuid-XXXX/appdata/fincalc - and back it up.
FINCALC_DATA_DIR=./data

# Port on the host (http://<server-ip>:8090).
FINCALC_PORT=8090

# User/group that owns FINCALC_DATA_DIR on the host (`id <user>` shows them).
PUID=1000
PGID=1000

# Timezone used to display dates (data is stored in UTC).
FINCALC_TIMEZONE=Europe/Budapest

# Log level: critical, error, warning, info, debug, trace (lowercase).
FINCALC_LOG_LEVEL=info

# Build from the GitHub repository (default) or from a local checkout (.).
# FINCALC_BUILD_CONTEXT=.
